# Optional Fireworks AI model for intent normalization (server-side only).
# Copy this file to .env and place your real key in FIREWORKS_API_KEY.
# Do not put provider secrets in frontend/.env.local or any VITE_ variable.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/qwen3-235b-a22b-instruct-2507

# Optional aliases for existing OpenAI-compatible environment conventions.
# FIREWORKS_* values take precedence when both sets are present.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Local application settings
APP_ENV=development
DATABASE_PATH=backend/fixflow.db
FRONTEND_ORIGIN=http://localhost:5173
MCP_ENDPOINT=http://127.0.0.1:8000/mcp
