# MCP connection for the local backend
VITE_MCP_URL=http://127.0.0.1:8000/mcp

# Optional: use the backend-hosted Fireworks model for safe intent normalization.
# The API key belongs in the project-root .env only, never in this file.
VITE_API_URL=http://127.0.0.1:8000
VITE_ENABLE_LLM_ROUTER=false

cd "$HOME/fixflow"
source .venv/bin/activate

uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8000

cd "$HOME/fixflow/frontend"
npm run dev